msgid "致谢"
msgstr "Agradecimentos"

msgid "感谢 QQ 交流群里提供使用反馈的每一位成员，也感谢以下贡献者。"
msgstr "Obrigado a todos no grupo QQ que compartilharam feedback, e aos seguintes colaboradores."

msgid "nothingeasy — 输入路径清单的导入与保存建议。"
msgstr "Não é fácil  ⁇  Sugerido importar e guardar listas de vias de entrada."

msgid "JuZiSYJ — 同步放大与带框原图导出建议。"
msgstr "JuZiSYJ  ⁇  Sugerido aumento sincronizado e exportação de originais com caixas."

msgid "ymingsu — 实现文件清单导入。"
msgstr "Importação de listas de arquivos implementadas."

msgid "Faberman — 建议增加图像标题和放大图 1:1 输出，翻译并润色英文 README。"
msgstr "Faberman  ⁇  Sugeriu títulos de imagens e exportação de um amplificador 1:1, e traduziu e editou o README em inglês."

msgid "stefanklut — 建议支持隐藏放大图边框。"
msgstr "Stefanklut sugeriu uma opção para esconder fronteiras mais amplificadas."

msgid "FunkyKoki — 提出局部显示图像和放大图排布建议。"
msgstr "FunkyKoki  ⁇  Sugerido visualização parcial de imagens e layouts adicionais do amplificador."

msgid "wwhio — 放大框颜色设置。"
msgstr "wwhio  ⁇  Contribuição de configurações de cores da caixa de zoom."

msgid "wzy — 引入 CI/CD，搭建多语言 Read the Docs 网站，支持通过 pip 安装。"
msgstr "Introdução de CI/CD, configuração multilingue do hospedagem Read the Docs e instalação de pip habilitada."
