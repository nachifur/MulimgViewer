#: ../../misc/acknowledgements.md:1
msgid "致谢"
msgstr "Acknowledgements"

msgid "感谢 QQ 交流群里提供使用反馈的每一位成员，也感谢以下贡献者。"
msgstr "Thank you to everyone in the QQ group who shared feedback, and to the following contributors."

msgid "nothingeasy — 输入路径清单的导入与保存建议。"
msgstr "nothingeasy — Suggested importing and saving lists of input paths."

msgid "JuZiSYJ — 同步放大与带框原图导出建议。"
msgstr "JuZiSYJ — Suggested synchronized magnification and exporting originals with boxes."

msgid "ymingsu — 实现文件清单导入。"
msgstr "ymingsu — Implemented file-list import."

msgid "Faberman — 建议增加图像标题和放大图 1:1 输出，翻译并润色英文 README。"
msgstr "Faberman — Suggested image titles and 1:1 magnifier export, and translated and edited the English README."

msgid "stefanklut — 建议支持隐藏放大图边框。"
msgstr "stefanklut — Suggested an option to hide magnifier borders."

msgid "FunkyKoki — 提出局部显示图像和放大图排布建议。"
msgstr "FunkyKoki — Suggested partial image views and additional magnifier layouts."

msgid "wwhio — 放大框颜色设置。"
msgstr "wwhio — Contributed zoom-box colour settings."

msgid "wzy — 引入 CI/CD，搭建多语言 Read the Docs 网站，支持通过 pip 安装。"
msgstr "wzy — Introduced CI/CD, set up multilingual Read the Docs hosting and enabled pip installation."
