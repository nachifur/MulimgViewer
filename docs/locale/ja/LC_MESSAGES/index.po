msgstr ""
"Language: ja\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "安装与上手"
msgstr "はじめに"

msgid "操作参考"
msgstr "操作リファレンス"

msgid "开发与贡献"
msgstr "開発と貢献"

msgid "版本与致谢"
msgstr "リリースと謝辞"

msgid "Languages"
msgstr "言語"

msgid "MulimgViewer 中文手册"
msgstr "MulimgViewer ユーザーマニュアル"

msgid "[选择文档语言 · Choose your language](languages.md)"
msgstr "[文書の言語を選択する](languages.md)"

msgid "**并行浏览，逐帧对比。**"
msgstr "**横に並べて フレームごとに比較する**"

msgid "在同一页对齐多个图像或视频来源，同步放大细节，将原图与算法结果一起导出。"
msgstr "複数のソースから画像やビデオを1ページに並べ,同じ領域を源間拡大し,アルゴリズム結果とともにオリジナルを輸出する."

msgid "[运行双视频示例](resources/usage.md)"
msgstr "[2つのビデオ例を試してみてください](resources/usage.md)"

msgid "Cat 和 Sunset 并排翻页，右侧展开 Input & Playback。"
msgstr "猫とサントは,Input & Playbackが目に見えるように並んで前進します."

msgid "左格是 Cat，右格是 Sunset。单击下一页，两路同时前进一帧。"
msgstr "猫は左,夕陽は右. 片段を1フレームで前へ移動させるため,1ページ先へ進む."

msgid "**十张超 4K 图，只比同一处细节。**"
msgstr "**4Kを超えた10枚の画像 詳細は本来の解析度です**"

msgid "在鸟头上画一次框，隐藏原图。十张 4608 × 2592 图像的同一块 160 × 160 像素区域并排铺开，沿鸟喙就能比较不同插值的边缘。"
msgstr "鳥の頭を箱に once と隠す完全な画像. 10 つの 4608 × 2592 画像から同じ 160 × 160 ピクセルを,インターポレーション方法を通してビックの辺に沿って比較します."

msgid "{ref}`跟做 1:1 对比 <native-detail>` [下载无损 PNG](media/sr-detail-native.png)"
msgstr "{ref}`1:1 の比較を試す <native-detail>` [損失のない PNG をダウンロードする](media/sr-detail-native.png)"

msgid "在完整窗口内框选鸟头，切换到只显示十个原尺寸局部。"
msgstr "鳥の頭を箱に入れ 10種に本来の分辨率で作物を表示する方法を全窓から記録しています"

msgid "跟随录屏设置放大框，再下载最终画布的 PNG，按 100% 查看边缘细节。"
msgstr "録音をフォローして放大機を設定します 端を比較するために,最終キャンバスを PNG としてダウンロードして100%で表示します."

msgid "**点一个位置，挑出一组样本。**"
msgstr "**位置を1つ選んで 配合セットを保持する**"

msgid "A、B 两个来源各占一行，每行显示三张。点中 B 行的第二张并保存，A 行的第二张也会一起导出。"
msgstr "ソース A と B はそれぞれ 3 つの画像の 1 行を占めています. B 行中画像を選択し,両行中画像を輸出するために保存します."

msgid "{ref}`跟做并行挑图 <multi-source-picks>`"
msgstr "{ref}`歩行を進める <multi-source-picks>`"

msgid "两行三列显示 A、B 的图像，点中下排中间一张，保存后重新打开两个来源的结果。"
msgstr "2行で6枚の画像 下行の中央画像が選択され,保存されたペアを再開します."

msgid "Per source 设为 1,3。点中 B/02.png，按 Ctrl+S，再打开输出目录核对两张 02.png。"
msgstr "源ごとに 1.3 に設定する B/02.png をクリックして,Ctrl+S を押して,出力フォルダを再開して 02.png の両コピーを確認します."

msgid "关闭"
msgstr "閉じる"

msgid "试试同步翻帧"
msgstr "2 本の動画をコマ送りする"

msgid "上一帧"
msgstr "前のフレーム"

msgid "下一帧"
msgstr "次のフレーム"

msgid "Cat 与 Sunset 同步画面"
msgstr "シンクロな猫と夕日の眺め"

msgid "试试并行挑图"
msgstr "一括選択を試す"

msgid "点选任一文件，查看两个来源会一起保存哪一张。"
msgstr "両源から一致する選択を表示するためにファイルを選択します."

msgid "将一起保存"
msgstr "同時に保存する画像："

msgid "功能亮点"
msgstr "注目の機能"

msgid "恢复轮播"
msgstr "スライドショーを再開"

msgid "暂停轮播"
msgstr "スライドショーを一時停止"

msgid "[下载与安装](resources/install.md) 选择系统对应的桌面包，或从源码安装"
msgstr "[ダウンロード・インストール](resources/install.md) ソースからデスクトップパケットを選択またはインストール"

msgid "[界面与快捷键](resources/interface.md) 从图标或菜单名查操作"
msgstr "[インターフェイスとショートカット](resources/interface.md) アイコンまたはメニュー名によってアクションを検索"

msgid "[右侧设置栏](resources/settings.md) 按分组查参数和生效方式"
msgstr "[設定サイドバー](resources/settings.md) 制御機能と編集が有効になる時をチェック"

msgid "[使用技巧](resources/large-images.md) 核对来源、视频时间与原尺寸细节"
msgstr "[実践的なアドバイス](resources/large-images.md) ソースのマッチング,タイミングとネイティブ解析度をチェックする"

msgid "本页演示开发版功能。正在使用 3.9.7？请查看 [3.9.7 中文手册](https://mulimgviewer.readthedocs.io/zh-cn/docs-v3.9.7-r1/)。"
msgstr "このページでは開発バージョンの予見が表示されます. 3.9.7 ランニング? 参照 [保存された 3.9.7 手帳 (中国語)](https://mulimgviewer.readthedocs.io/zh-cn/docs-v3.9.7-r1/)."

msgid "当前手册版本为 {sub-ref}`release`。[查看 3.9.7 中文手册](https://mulimgviewer.readthedocs.io/zh-cn/docs-v3.9.7-r1/)。"
msgstr "この手帳にはバージョンが記載されています {sub-ref}`release`. [保存された3.9.7手帳 (中国語) をご覧ください](https://mulimgviewer.readthedocs.io/zh-cn/docs-v3.9.7-r1/)."
