msgid "Next / Last"
msgstr "Di Last / Last"

msgid "**Ctrl+N / Ctrl+L** 下一页 / 上一页。"
msgstr "**E / Ctrl+N / Ctrl+L** Di next page go move to di next page"

msgid "Save / Refresh / Hidden"
